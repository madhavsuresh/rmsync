# rmsync configuration — Docker default. Mounted at /config/config.toml.
# Edit and ``docker restart rmsync`` for changes to take effect.

# /sync is the convention used by docker-compose.yml and docs/DOCKER.md.
# Bind-mount your host directory into /sync to make it the synced tree.
sync_dir      = "/sync"
remote_folder = "Writing"

worker_pool_size               = 3
poll_interval_seconds          = 30
poll_active_interval_seconds   = 15
poll_idle_interval_seconds     = 120
debounce_seconds               = 2.0
echo_fence_seconds             = 5.0
retry_max_attempts             = 3

# native_plain: plain text only (recommended)
# native_formatted: experimental, not fully implemented
# pdf: read-only on tablet, not fully implemented
push_strategy = "native_plain"

backup_snapshots_to_keep = 30
dry_run                  = false

[log]
level = "INFO"   # DEBUG | INFO | WARNING | ERROR
