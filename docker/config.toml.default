# rmsync configuration — Docker default. Mounted at /config/config.toml.
# Edit and ``docker restart rmsync`` for changes to take effect.

# /sync is the convention used by docker-compose.yml and docs/DOCKER.md.
# Bind-mount your host directory into /sync to make it the synced tree.
sync_dir      = "/sync"
remote_folder = "Writing"

# Explicit pushes are incremental: unchanged tracked Markdown files
# are counted as skipped and do not call rmapi. Use `rmsync push --force`
# to bypass the unchanged-hash no-op path for selected files.
# Local deletes affect the cloud only with `rmsync push --include-deletes`.
# Cloud deletes affect local files only after `rmsync pull`, `rmsync diff`,
# and `rmsync accept --include-deletes <path>`.

[deletion]
trash_retention_days = 30 # 0 keeps local .rmsync-trash entries forever

# Optional: web dashboard (replaces the macOS menubar for Linux users).
# When enabled, daemon listens on the configured TCP port and serves
# a status page + pause/resume actions. Sync mutations stay in the CLI.
# Auth via Bearer
# token; if ``auth_token`` is unset, daemon generates one and writes
# it to ``$STATE_DIR/web-token``. Expose the port via docker-compose
# ``ports:`` if you want LAN access.
# [web]
# enabled    = true
# bind_addr  = "0.0.0.0"   # localhost-only is "127.0.0.1"
# port       = 7878
# auth_token = ""          # leave empty → auto-generated
