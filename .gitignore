# Python legacy — most of this is no longer used but the ignore rules
# are cheap to keep in case anyone cracks open python-legacy.tar.gz.
__pycache__/
*.pyc
*.pyo
.venv/
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# macOS
.DS_Store

# Claude Code per-machine settings (contains absolute paths + dev
# session allowlist; not useful to share).
.claude/

# Swift Package Manager build tree. Regenerated by `swift build`.
# Absolute paths baked into .d files make diffs noisy.
swift/.build/
swift/.swiftpm/
swift/.swift-home/
swift/Package.resolved.backup

# Xcode, if anyone opens the SPM package in it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# Local state that might accidentally land in the repo root during
# development (daemon logs, state snapshots, etc).
*.log
state.db
state.db-*
ipc.sock
