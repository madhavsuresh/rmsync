<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.user.rmsync.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__MENUBAR_BIN__</string>
    </array>

    <!-- GUI app — only run while the user is logged in. -->
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>

    <key>RunAtLoad</key><true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
        <key>Crashed</key><true/>
    </dict>

    <key>ThrottleInterval</key><integer>10</integer>

    <key>StandardOutPath</key><string>__HOME__/Library/Logs/rmsync/menubar.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/rmsync/menubar.log</string>
</dict>
</plist>
